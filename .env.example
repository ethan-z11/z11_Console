# ============================================================
# 家庭控制台 - Docker Compose 环境变量配置
# 复制本文件为 .env 并按需修改：  cp .env.example .env
# ============================================================

# 宿主机访问端口（容器内固定为 8765，改这里即可改访问端口）
HOME_CONSOLE_PORT=8765

# 令牌加密密钥（Fernet 格式，base64 编码的 32 字节）。
# 强烈建议设置：让加密密钥脱离数据目录，数据文件单独泄露时不会暴露 HA 令牌。
#
# 生成方式（任选其一）：
#   1. 本机有 Python+cryptography：
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   2. 用 Docker 临时生成：
#      docker run --rm python:3.12-slim sh -c "pip install -q cryptography && python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
#
# 留空时服务会在数据目录自动生成 secret.key，也能正常使用。
HOME_CONSOLE_SECRET=

# ---------- Cookie 策略（被 HA 等 iframe 嵌入时需要关注）----------
# SameSite：Strict（默认，最严）/ Lax / None
#   - 控制台与 HA 在【同一个 IP】（同站）：Strict 或 Lax 均可，保持默认即可。
#   - 控制台与 HA 在【不同 IP】（跨站）：必须设为 None，但浏览器要求
#     SameSite=None 必须配合 Secure（HTTPS）。纯 HTTP 跨站嵌入浏览器
#     不允许携带 Cookie，需用反向代理把控制台与 HA 变成同站（同 IP）。
HOME_CONSOLE_COOKIE_SAMESITE=Strict
# 强制 Secure（HTTPS only）。SameSite=None 时会自动开启，一般不用手动设。
# HOME_CONSOLE_COOKIE_SECURE=
